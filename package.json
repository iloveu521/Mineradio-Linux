{
  "name": "mineradio-linux",
  "productName": "Mineradio",
  "version": "1.2.0",
  "description": "A Linux desktop music player with weather radio, lyric stage, particle visuals, and 3D playlist shelf.",
  "author": "Silly <iloveu521@users.noreply.github.com>",
  "main": "desktop/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --linux appimage deb",
    "build:dir": "electron-builder --linux dir"
  },
  "build": {
    "appId": "com.mineradio.linux",
    "productName": "Mineradio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      "public/**/*",
      "build/icon.png",
      "server.js",
      "dj-analyzer.js",
      "package.json",
      "!public/index.*.html",
      "public/index.html"
    ],
    "asar": false,
    "linux": {
      "executableName": "mineradio",
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "iloveu521",
        "repo": "Mineradio-Linux"
      }
    ]
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "mpg123-decoder": "^1.0.3",
    "NeteaseCloudMusicApi": "^4.32.0"
  },
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3"
  }
}
